/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), camera=(self)

# HTML / entrypoint: mai cache lunghe, altrimenti la PWA installata resta sulla build vecchia.
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/flutter_bootstrap.js
  Cache-Control: no-cache, no-store, must-revalidate

/flutter.js
  Cache-Control: no-cache, no-store, must-revalidate

/main.dart.js
  Cache-Control: no-cache, no-store, must-revalidate

/flutter_service_worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/pwa_helper.js
  Cache-Control: no-cache, no-store, must-revalidate

/push_session.js
  Cache-Control: no-cache, no-store, must-revalidate

/cronos_update_check.js
  Cache-Control: no-cache, no-store, must-revalidate

/cronos_sw.js
  Cache-Control: no-cache, must-revalidate

/push_handlers.js
  Cache-Control: no-cache, must-revalidate

/push-sw.js
  Cache-Control: no-cache, must-revalidate

/manifest.json
  Cache-Control: no-cache, must-revalidate

/version.json
  Cache-Control: no-cache, must-revalidate

/app_revision.json
  Cache-Control: no-cache, no-store, must-revalidate

# Asset con hash nel nome (canvaskit, font, pezzi JS): cache lunga ok.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable
